# Salin file ini menjadi .env.local lalu isi nilainya

# Connection string MongoDB (MongoDB Atlas / lokal)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cafe_pintar?retryWrites=true&w=majority

# Xendit > Settings > API Keys (pakai Secret Key mode TEST: xnd_development_...)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx

# Xendit > Settings > Webhooks > "Verification Token" (dipakai untuk cek header x-callback-token)
XENDIT_CALLBACK_TOKEN=isi_verification_token_dari_dashboard_xendit

# URL aplikasi (lokal: http://localhost:3000, atau URL vercel / ngrok)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
